rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{files}/rooms/{room}/{file} {
    	allow get, write: if true;
    }
    // `{file=**}` (not `{file}`) so version snapshots one level deeper —
    // files/shareLinks/<id>/versions/<n> — are covered too, not just
    // files/shareLinks/<id>/scene.
    match /{files}/shareLinks/{shareLink}/{file=**} {
    	allow get, write: if true;
    }
  }
}
